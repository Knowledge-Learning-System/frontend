                {id: 29, courseId: 4, knowledgePointId: '6320845', title: '第二节 模式分解 模式分解', filePath: '视频\\第七章 数据库设计：属性-联系方法（上）\\第二节 模式分解_模式分解_blurred.mp4', duration: null},
                {id: 30, courseId: 4, knowledgePointId: '6320845', title: '第三节 范式 范式', filePath: '视频\\第七章 数据库设计：属性-联系方法（下）\\第三节 范式_范式_blurred.mp4', duration: null},
                {id: 31, courseId: 4, knowledgePointId: '6320845', title: '第五节 大数据与反规范化 大数据与反规范化', filePath: '视频\\第七章 数据库设计：属性-联系方法（下）\\第五节 大数据与反规范化_大数据与反规范化_blurred.mp4', duration: null},
                {id: 32, courseId: 4, knowledgePointId: '6320845', title: '第四节 规范化 规范化', filePath: '视频\\第七章 数据库设计：属性-联系方法（下）\\第四节 规范化_规范化_blurred.mp4', duration: null}
              ],
              coursewares: [
                {id: 128, courseId: 4, knowledgePointId: '6320845', title: '第七章ppt_第七章ppt精炼版', filePath: '课件\\第七章ppt_第七章ppt精炼版.pdf', fileType: 'pdf'},
                {id: 129, courseId: 4, knowledgePointId: '6320845', title: '第七章ppt_第七章ppt（上1）详细版', filePath: '课件\\第七章ppt_第七章ppt（上1）详细版.pdf', fileType: 'pdf'},
                {id: 130, courseId: 4, knowledgePointId: '6320845', title: '第七章ppt_第七章ppt（上2）详细版', filePath: '课件\\第七章ppt_第七章ppt（上2）详细版.pdf', fileType: 'pdf'},
                {id: 131, courseId: 4, knowledgePointId: '6320845', title: '第七章ppt_第七章ppt（下）详细版', filePath: '课件\\第七章ppt_第七章ppt（下）详细版.pdf', fileType: 'pdf'}
              ],
              questions: [
                {id: 48, type: 'judge', content: '一个关系模式中不同属性在取值上总会存在相互依赖又相互制约，这种属性与属性之间的联系，称为函数依赖。', options: '["A. 正确", "B. 错误"]', answer: 'B', analysis: '【所属章节：第一节 函数依赖】', knowledgePointId: '6320845'},
                {id: 49, type: 'judge', content: '给定关系模式S的函数依赖集D， D逻辑蕴涵的所有函数依赖的集合称为D的闭包。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 函数依赖】', knowledgePointId: '6320845'},
                {id: 53, type: 'judge', content: 'H与G等价则H中的每个函数依赖属于H的闭包。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 函数依赖】', knowledgePointId: '6320845'},
                {id: 134, type: 'judge', content: '如果关系模式S<A，D>是1NF，且每个属性都既不部分也不传递依赖于S的任何候选键，那么称S是第三范式(3NF)的模式。', options: '["A. 正确", "B. 错误"]', answer: 'B', analysis: '【所属章节：第三节 范式】', knowledgePointId: '6320845'},
                {id: 135, type: 'judge', content: '如果关系模式S<A，D>是第三范式，它的任何一个主属性都既不部分也不传递依赖于S的任何候选键，则称S∈BCNF。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第三节 范式】', knowledgePointId: '6320845'},
                {id: 137, type: 'judge', content: '关系模式S<A，D>∈1NF，其D中任意一个非平凡函数依赖的决定因素都包含键，则S∈BCNF。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第三节 范式】', knowledgePointId: '6320845'},
                {id: 180, type: 'judge', content: '模式分解需要关注的特性是：是否无损联接、是否保持依赖。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第二节 模式分解】', knowledgePointId: '6320845'},
                {id: 181, type: 'judge', content: '把一个关系模式分解为两个关系模式时，分解具有无损联接性的充分必要条件是两个关系模式的公共属性是其中一个模式的键。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第二节 模式分解】', knowledgePointId: '6320845'},
                {id: 182, type: 'judge', content: '如果某个分解不能保持函数依赖，则分解后的模式利用函数依赖约束来保护数据完整性的能力将会被削弱。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第二节 模式分解】', knowledgePointId: '6320845'},
                {id: 184, type: 'judge', content: '保持函数依赖的分解必定具有无损连接性。', options: '["A. 正确", "B. 错误"]', answer: 'B', analysis: '【所属章节：第二节 模式分解】', knowledgePointId: '6320845'},
                {id: 201, type: 'judge', content: '若关系模式的规范化程度越高，优势在于数据冗余、插入异常、删除异常、修改复杂等问题越少。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第五节 大数据与反规范化】', knowledgePointId: '6320845'},
                {id: 202, type: 'judge', content: '较低范式的劣势在于数据冗余造成的空间代价以及修改代价（插入异常、删除异常、修改复杂）高。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第五节 大数据与反规范化】', knowledgePointId: '6320845'},
                {id: 204, type: 'judge', content: '关系模式满足的范式级别越高越好。', options: '["A. 正确", "B. 错误"]', answer: 'B', analysis: '【所属章节：第五节 大数据与反规范化】', knowledgePointId: '6320845'},
                {id: 273, type: 'judge', content: '把较低范式的关系模式分解为若干较高范式的关系模式的方法不是唯一的，只有能够保证分解后的关系模式与原关系模式等价，分解才有意义。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第四节 规范化】', knowledgePointId: '6320845'},
                {id: 274, type: 'judge', content: '关系模式规范化实际上就是一个模式分解过程：把逻辑上相对独立的信息放在独立的关系模式中。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第四节 规范化】', knowledgePointId: '6320845'}
              ]
            }
          ]
        },
