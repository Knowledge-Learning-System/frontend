              questions: [
                {id: 76, type: 'judge', content: '实体联系方法，以实体为中心，着重于一个关系模式，基本对应一个实体或联系，即关系模式与实体或联系之间基本是一一对应的。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 数据库设计方法和生命周期】', knowledgePointId: '6320844'},
                {id: 185, type: 'judge', content: 'E-R图主要包括实体和联系以及它们各自的属性。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第二节 第一小节 E-R模型元素】', knowledgePointId: '6320844'},
                {id: 239, type: 'judge', content: '含弱实体E-R图向关系模式转换时，一个关联弱实体的联系和弱实体一起转换为一个关系模式，主键是参与联系的强实体的主键。', options: '["A. 正确", "B. 错误"]', answer: 'B', analysis: '【所属章节：第四节 扩展E-R图及其转换】', knowledgePointId: '6320844'}
              ]
