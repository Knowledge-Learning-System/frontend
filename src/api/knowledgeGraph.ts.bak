                {id: 45, type: 'judge', content: '关系数据库使用一个或多个表来存储数据。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 关系结构和约束】', knowledgePointId: '6320775'},
                {id: 46, type: 'judge', content: '关系数据库中，同一表中行次序无关紧要。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 关系结构和约束】', knowledgePointId: '6320775'},
                {id: 47, type: 'judge', content: '关系数据库中，因为每个列都有一个名字，同一表中列次序无关紧要。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 关系结构和约束】', knowledgePointId: '6320775'},
                {id: 50, type: 'judge', content: '考官表中，按照反射律，(erid,ername)→ername成立。', options: '["A. 正确", "B. 错误"]', answer: 'A', analysis: '【所属章节：第一节 函数依赖】', knowledgePointId: '6320775'},
